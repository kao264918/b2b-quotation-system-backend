# Environment Variables Example
# Copy this file to .env and fill in your values

# Database (Railway PostgreSQL or other)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Environment
ENVIRONMENT=development

# Frontend base URL (used for email links)
APP_BASE_URL=http://localhost:5173

# CORS — explicit list of allowed origins (JSON array)
# Production example:
# CORS_ORIGINS=["https://your-app.vercel.app"]
# Development example:
# CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# CORS origin regex for Vercel preview deployments (optional).
# Restrict to YOUR project prefix, e.g.: https://b2b-quotation-.*\.vercel\.app
# CORS_ORIGIN_REGEX=https://b2b-quotation-.*\.vercel\.app

# Brevo Transactional Email (Backend only)
# IMPORTANT: never hardcode real secrets in git.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=contact.ventottodesign@gmail.com
BREVO_SENDER_NAME=Ventotto Design

# Redis (STRONGLY recommended for production rate limiting)
REDIS_URL=

# Uvicorn trusted proxy IPs (default: '*' trusts all).
# In production, set to your load balancer CIDR, e.g. "10.0.0.0/8"
# FORWARDED_ALLOW_IPS=*
