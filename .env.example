# Environment Variables Example
# Copy this file to .env and fill in your values

# Database (Railway PostgreSQL or other)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Environment
ENVIRONMENT=development

# Frontend base URL (used for email links)
APP_BASE_URL=http://localhost:5173

# CORS (comma-separated list of allowed origins)
# CORS_ORIGINS=["http://localhost:5173","https://your-app.vercel.app"]

# Brevo Transactional Email (Backend only)
# IMPORTANT: never hardcode real secrets in git.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=contact.ventottodesign@gmail.com
BREVO_SENDER_NAME=Ventotto Design
